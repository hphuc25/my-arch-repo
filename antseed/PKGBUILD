# Maintainer: hphuc25 <https://github.com/hphuc25/my-arch-repo>
#
# Source = GitHub archive pinned to one commit (no submodule).
# To bump: pick a new commit, set _commit, set pkgver to the value of
# apps/cli/package.json at that commit, then refresh sha256sums (makepkg -g).

pkgname=antseed
pkgver=0.1.169
pkgrel=1
_commit=79f6214ea6cf34cfeae3271965f08161a30b06eb
_srcdir="antseed-${_commit}"
pkgdesc="AntSeed P2P AI network - an open market for AI inference (seller/buyer CLI)"
arch=('x86_64')
url="https://github.com/Antseed/antseed"
license=('GPL-3.0-only')
depends=('nodejs' 'npm')
makedepends=('pnpm' 'python' 'make' 'gcc')
options=('!strip')
source=(
	"antseed-${_commit}.tar.gz::https://github.com/Antseed/antseed/archive/${_commit}.tar.gz"
)
sha256sums=('eff0d7b4c97755ffc2f3ea8ec7c35517ec6cb6627e23fada367c3c4ceccac668')

build() {
	cd "${srcdir}/${_srcdir}"

	# Locked better-sqlite3 12.6.2 only supports Node <= 25, the runner (and
	# any current Arch box) ships Node 26 → compile fails. 12.11.1 still
	# satisfies upstream's ^12.6.2 range and adds Node 26 support, so bump it
	# inside the lockfile instead of downgrading Node (a Node-24 build would
	# produce a native module the Node-26 runtime refuses to load).
	pnpm update better-sqlite3 --recursive
	pnpm install --no-frozen-lockfile

	# Same recipe as upstream .github/workflows/npm-publish.yml:
	# build in dependency order, only the CLI from tier4 (no Electron desktop).
	pnpm run build:tier0
	pnpm run build:tier1
	pnpm run build:tier2
	pnpm run build:tier3
	pnpm --filter=@antseed/cli run build
}

package() {
	cd "${srcdir}/${_srcdir}"

	# self-contained production tree: dist/ + node_modules with runtime deps only
	pnpm --filter=@antseed/cli deploy --prod "${srcdir}/deploy"

	install -d "${pkgdir}/usr/lib/${pkgname}"
	cp -a "${srcdir}/deploy"/. "${pkgdir}/usr/lib/${pkgname}/"
	chmod 755 "${pkgdir}/usr/lib/${pkgname}/dist/cli/index.js"

	install -d "${pkgdir}/usr/bin"
	ln -s "../lib/${pkgname}/dist/cli/index.js" "${pkgdir}/usr/bin/${pkgname}"

	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
