# Maintainer: Phuc Hoang <https://github.com/hphuc25>
# Umbriel — Wayland compositor on wlroots + SceneFX (patched fork)
# Local package for my-arch-repo: built by build-release.yml (cachyos-v3)
# and published to the pacman repo at releases/download/repository (db: nanoka).
# Install with: pacman -S umbriel  (after adding [nanoka] to pacman.conf)

pkgname=umbriel
pkgver=0.1.0
pkgrel=1
pkgdesc='A Wayland compositor built on wlroots and SceneFX'
arch=('x86_64')
url='https://github.com/hphuc25/umbriel'
license=('MIT')
depends=(
  'cairo'
  'gcc-libs'
  'glibc'
  'jemalloc'
  'libdrm'
  'libinput'
  'libxkbcommon'
  'nlohmann-json'
  'pango'
  'pixman'
  'systemd'
  'tomlplusplus'
  'wayland'
  'wlroots0.20'
)
makedepends=(
  'git'
  'glm'
  'json-c'
  'lcms2'
  'libglvnd'
  'mesa'
  'meson'
  'ninja'
  'wayland-protocols'
)
optdepends=(
  'xdg-desktop-portal-umbriel: screencast and screenshot portals'
  'xwayland-satellite: X11 application support'
)
source=("git+https://github.com/hphuc25/umbriel.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/umbriel"
  (
    set -o pipefail
    git describe --tags --long 2>/dev/null | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
  ) || printf '%s.r%s.g%s' \
      "$(sed -En "s/^ *version: *'([^']+)'.*/\1/p" meson.build | head -n1)" \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$srcdir/umbriel"
  git submodule update --init --recursive
}

build() {
  cd "$srcdir/umbriel"
  # datadir is compiled-in; must configure with final prefix /usr
  meson setup _build --buildtype=release --prefix=/usr
  meson compile -C _build
}

check() {
  meson test -C "$srcdir/umbriel/_build" --print-errorlogs
}

package() {
  meson install -C "$srcdir/umbriel/_build" --skip-subprojects --destdir "$pkgdir"
  install -Dm644 "$srcdir/umbriel/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
